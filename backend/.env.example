# ─── Google OAuth 2.0 / OIDC ──────────────────────────────────────────────────
# Create credentials at https://console.developers.google.com → OAuth 2.0 Client IDs
# Authorised redirect URIs must include GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://snoti.onrender.com/api/auth/google/callback

# ─── Session / Auth ───────────────────────────────────────────────────────────
# Frontend URL used for the post-login redirect (must match your deploy URL)
FRONTEND_URL=https://snoti.onrender.com
# Path to the SQLite sessions database (defaults to backend/data/sessions.db)
SESSIONS_DB_PATH=
# Path to the allowed-emails CSV (defaults to backend/data/allowed_emails.csv)
ALLOWED_EMAILS_PATH=

# ─── Server ───────────────────────────────────────────────────────────────────
# Portul pe care porneste serverul (Render il seteaza automat prin variabila PORT)
PORT=3000

# Secret folosit pentru a proteja endpoint-ul /api/fetch-rates
# Cron-Job.org (sau alt serviciu) trebuie sa trimita acest secret ca
# query param (?secret=...) sau ca header (x-cron-secret: ...)
CRON_SECRET=schimba-acest-secret-cu-unul-al-tau

# Lista implicita de simboluri / ETF-uri pentru verificarea RSI (separate prin virgula)
DEFAULT_RSI_SYMBOLS=WEBN.DE,IWDA.AS

# URL-ul Webhook-ului Discord principal (pentru raportul zilnic de curs valutar)
WEBHOOK_URL=https://discord-api-proxy.batusel-cristian-a1b.workers.dev/webhooks/YOUR_MAIN_WEBHOOK_URL

# URL-ul Webhook-ului Discord pentru canalul #trading (pentru alerte RSI <= 40, <= 35, <= 30)
TRADING_WEBHOOK_URL=https://discord-api-proxy.batusel-cristian-a1b.workers.dev/webhooks/YOUR_TRADING_WEBHOOK_URL

# Secret pentru proxy-ul Discord (Cloudflare Worker) transmis in header-ul x-proxy-secret
PROXY_SECRET=schimba-acest-secret-cu-secretul-de-proxy



# Portul pe care porneste serverul (Render il seteaza automat prin variabila PORT)
PORT=3000

# Secret folosit pentru a proteja endpoint-ul /api/fetch-rates
# Cron-Job.org (sau alt serviciu) trebuie sa trimita acest secret ca
# query param (?secret=...) sau ca header (x-cron-secret: ...)
CRON_SECRET=schimba-acest-secret-cu-unul-al-tau

# Lista implicita de simboluri / ETF-uri pentru verificarea RSI (separate prin virgula)
DEFAULT_RSI_SYMBOLS=WEBN.DE,IWDA.AS

# URL-ul Webhook-ului Discord principal (pentru raportul zilnic de curs valutar)
WEBHOOK_URL=https://discord-api-proxy.batusel-cristian-a1b.workers.dev/api/webhooks/YOUR_MAIN_WEBHOOK_URL

# URL-ul Webhook-ului Discord pentru canalul #trading (pentru alerte RSI <= 40, <= 35, <= 30)
TRADING_WEBHOOK_URL=https://discord-api-proxy.batusel-cristian-a1b.workers.dev/api/webhooks/YOUR_TRADING_WEBHOOK_URL

# Secret pentru proxy-ul Discord (Cloudflare Worker) transmis in header-ul x-proxy-secret
PROXY_SECRET=schimba-acest-secret-cu-secretul-de-proxy



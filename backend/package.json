{
  "name": "curs-valutar-backend",
  "version": "1.0.0",
  "description": "Backend Express + TypeScript pentru monitorizarea cursului valutar (BNR + EUR/USD) cu notificari push Expo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "axios": "^1.7.2",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.10.0",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.0",
    "react-dom": "18.3.1",
    "react-native-web": "~0.19.6",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
